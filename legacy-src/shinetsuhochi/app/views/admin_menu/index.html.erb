<script type="text/javascript"><!--
$(document).ready(function($){
	if ($("#id_adm_Success").val() == "true"){
	var height_t = 200;
	var width_t =  400;
	var title_t = "確認";
	$("#message").html('<img align="left" src="/assets/images/message_info.png" />次年度分情報自動生成が終了しました。');
	$("#message").dialog({
		autoOpen: true, modal: true, height: height_t, width: width_t, title: title_t, dialogClass: 'dlgclass',
		buttons: {   
			'ＯＫ': function(event) { $(this).dialog('close'); }
		}
	});
	}
	
});
//--></script>
