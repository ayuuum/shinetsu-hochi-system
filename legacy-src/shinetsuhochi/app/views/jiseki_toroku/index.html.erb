function dayhyoji2() {
	var hiduke = new Date();
	var y = hiduke.getFullYear();
	var m = hiduke.getMonth()+1;
	var d = hiduke.getDate();	
	if (m < 10) {
  		m = '0' + m;
	}
	if (d < 10) {
  		d = '0' + d;
	}
	var dateStr = y+"/"+m+"/"+d;	
	
	document.nm_frm_jiseki_Toroku.hoshukanryoYMD.value = dateStr;
}

