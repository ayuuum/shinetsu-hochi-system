<div id="restore_box">
	<%= form_tag( { :action => 'commit' },  { :remote => true,  :method => 'post', :name => 'nm_frm_BKS_Toroku' }) do  %>
	
	
	<% #---------- 認証後----------- %>	
	<div id="auth">

	<div class="ths03"><div class="midashi2_label_240_20">◆バックアップ年月</div></div>
	
	
	<div class="btr04">
		<div class="midashi_label_100_20">年</div>
		<%= select_tag('restoreY', options_for_select(@restoreY,@genY), :id => 'id_cmb_BTR_TenkenkaishiY', :class => 'select_108', :tabindex => 21) %>
		<div class="midashi_label_100_20">月</div>
		<%= select_tag('restoreM', options_for_select(@restoreM,@genM), :id => 'id_cmb_BTR_TenkenkaishiM', :class => 'select_108', :tabindex => 22) %>
	</div>
	<div class="kugiri"></div>
	<div style="margin:20px 0 10px 0;"></div>
	<div class="kugiri"></div>
