<script type="text/javascript"><!--
window.onload = function(){
 document.getElementById("id_txt_LOG_Id").focus();
 }

$(document).ready(function($){

 $('.loading').click(function() {
    $.blockUI({
      message: 'データを読み込んでいます。お待ち下さい・・・',
      css: {
        border: 'none',
        padding: '10px',
        backgroundColor: '#333',
        opacity: .9,
        color: '#fff',
        cursor: 'wait'
      },
      overlayCSS: {
        backgroundColor: '#000',
        opacity: 0.6
      }
    });
  });
	

});
