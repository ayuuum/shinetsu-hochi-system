<script lang="javascript">
// rewrite the 'onkeydown' event to make sure 'Enter' key can be used as 'Tab' in some needed circumstances.  It work fine on both IE and non-IE browsers.
document.onkeydown=function(evt)
{
	var isie = (document.all) ? true : false;
	var key;
	var srcobj;
	// if the agent is an IE browser, it's easy to do this.
	if (isie) {
		key = event.keyCode;
		srcobj=event.srcElement;
	}
	else {
		key = evt.which;
		srcobj=evt.target;
	}
	if(key==13 && srcobj.type!='button' && srcobj.type!='submit' &&srcobj.type!='reset' && 
	srcobj.type!='textarea' && srcobj.type!='') {
		if(isie)
			event.keyCode=9;
		else {
			var el=getNextElement(evt.target);
			
			while(el.type=='hidden' || el.type=='submit' || el.type=='radio' || el.readonly == true )
				el=getNextElement(el);

			if(!el)
				return false;
			else
				el.focus();
		}
	}
}
function getNextElement(field) {
	var form = field.form;
	for(var e = 0; e < form.elements.length; e++) {
		if (field == form.elements[e])
		break;
	}
	return form.elements[++e % form.elements.length];
}
</script>
