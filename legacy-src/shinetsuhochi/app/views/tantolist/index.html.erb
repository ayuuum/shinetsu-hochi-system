<script type="text/javascript"><!--
window.onload = function(){
 document.getElementById("id_cmb_TTL_Sanshonendo").focus();
 }
 
$(document).ready(function($){

	/* 点検担当者種別をセレクトしたとき 点検担当者名の表示を変える*/
	/* 点検担当者種別を変更したとき */
	$('#id_cmb_TTL_Tenshu').change(function() {
		/* 点検担当者種別value取得 */
		data = $('#id_cmb_TTL_Tenshu').val();
		string = "#id_cmb_TTL_Tenmei" + ("00" + data).slice(-3);
		/* 点検担当者名セレクトボックスすべて隠し*/
		$('.select_295_ttl').hide();
		/* #id_cmb_THS_Tenmei＋点検担当者種別valueのIDを表示*/
		$(string).show();
	}).keyup(function(){
		$(this).blur().focus();
		});

 $('.loading').click(function() {
    $.blockUI({
      message: 'データを読み込んでいます。お待ち下さい・・・',
      css: {
        border: 'none',
        padding: '10px',
        backgroundColor: '#333',
        opacity: .9,
        color: '#fff',
        cursor: 'wait'
      },
      overlayCSS: {
        backgroundColor: '#000',
        opacity: 0.6
      }
    });
  });


});
function to_buken_joho_shosai(bukenCode, hachushaCode) {
	location.href = "http://" + location.host + "/buken_joho_shosai/index/" + bukenCode + "/" + hachushaCode;
}
//--></script>


