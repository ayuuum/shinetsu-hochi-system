/* ボタンが押された場合、トップページ遷移のタイマーリセット*/
clearTimeout(timerID);
var timerID = setInterval("jumpHome()",3600*1000);

if (("<%= @error_message[0] %>").length > 0){
/* ローディングメッセージ解除*/
	$.unblockUI();
	
	var height_t = parseInt("<%= @dialog_height %>");
	var width_t =  parseInt("<%= @dialog_width %>");
	var title_t = "<%= @dialog_title %>";
	var focus = "<%= @focus %>";
	$("#message").html('<img align="left" src="/assets/images/<%= @error_message[0] %>.png" /><%= @error_message[1] %>');
	$("#message").dialog({
		autoOpen: true, modal: true, height: height_t, width: width_t, title: title_t, dialogClass: 'dlgclass',
		buttons: {   
			'ＯＫ': function(event) { 
				$(this).dialog('close'); 
				$("#" + focus).focus();
			}
		}
	});

} else if ('<%= @error %>' == '1'){
	$("#kensaku_kekka").empty();
	$("#kensaku_kekka").append('◆検索結果(<%= @sql_count %>件)');
	$("#hcl_table").empty();
	$("#hcl_table").html('<%=raw @html_string %>');
/* ローディングメッセージ解除*/	
	$.unblockUI();	
	
} else if ('<%= @error %>' == '2'){
/* ローディングメッセージ解除*/
	$.unblockUI();

	w = screen.width * (1);
	h = screen.height * (1);
	window.open("http://" + location.host + "/" + "<%= @pdf_name %>","","width=" + w + ",height=" + h + ",resizeable=no,scrollbars=yes,status=no,menubar=1");
	/*  window.open("http://" + location.host + "/" + "<%= @pdf_name %>");  */
}

