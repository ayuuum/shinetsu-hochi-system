<script type="text/javascript"><!--
$(document).ready(function($){

 $('.loading').click(function() {
    $.blockUI({
      message: 'データを読み込んでいます。お待ち下さい・・・',
      css: {
        border: 'none',
        padding: '10px',
        backgroundColor: '#333',
        opacity: .9,
        color: '#fff',
        cursor: 'wait'
      },
      overlayCSS: {
        backgroundColor: '#000',
        opacity: 0.6
      }
    });
  });

});
function to_yotei_joho(tuki, tenkenstatus, hoshustatus,nendo,jishituki,ren) {
	var year = $('#id_cmb_MOL_Sanshonendo').val()

	var thisYear = "<%= session[:konnendo] %>";
	if(parseInt(year) == thisYear -2 )
	{
		year = thisYear;
	}
	location.href = "http://" + location.host + "/yotei_admin/index/" + tuki + "/" + tenkenstatus + "/" + hoshustatus + "/" + year + "/" + jishituki + "/" + ren;
}
//--></script>


